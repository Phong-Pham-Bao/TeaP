// ============================================================
// TeaP ERP/POS — Prisma Schema
// Bubble Tea Chain Management System
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  SUPER_ADMIN
  MANAGER
  HR
  ACCOUNTANT
  CASHIER
  WAREHOUSE_STAFF
  KITCHEN_STAFF
}

enum ProductType {
  DRINK
  TOPPING
  MATERIAL
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  VNPAY
  MOMO
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum StockRefType {
  ORDER
  IMPORT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  BUY_X_GET_Y
}

enum CashFlowType {
  INCOME
  EXPENSE
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  DEAD_LETTER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalDecisionType {
  APPROVED
  REJECTED
}

// ============================================================
// BRANCHES
// ============================================================

model Branch {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  address   String   @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users             User[]
  userAssignments   UserBranchAssignment[]
  orders            Order[]
  inventories       Inventory[]
  stockLedgers      StockLedger[]
  cashFlows         CashFlow[]
  workSchedules     WorkSchedule[]
  auditEvents       AuditEvent[]
  documentSequences DocumentSequence[]
  approvalRequests  ApprovalRequest[]

  @@map("branches")
}

// ============================================================
// USERS & AUTHENTICATION
// ============================================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique @db.VarChar(150)
  password  String   @db.VarChar(255)
  fullName  String   @map("full_name") @db.VarChar(100)
  phone     String?  @db.VarChar(20)
  avatar    String?  @db.VarChar(500)
  role      Role     @default(CASHIER)
  branchId  String?  @map("branch_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch             Branch?                @relation(fields: [branchId], references: [id])
  branchAssignments  UserBranchAssignment[]
  refreshTokens      RefreshToken[]
  orders             Order[]
  attendances        Attendance[]
  salarySlips        SalarySlip[]
  workSchedules      WorkSchedule[]
  auditEvents        AuditEvent[]
  idempotencyRecords IdempotencyRecord[]
  approvalRequests   ApprovalRequest[]      @relation("ApprovalRequester")
  approvalDecisions  ApprovalDecision[]     @relation("ApprovalDecider")

  @@index([branchId])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid())
  // Legacy tokens are retained only so the migration is forward compatible.
  // New sessions always store a SHA-256 hash in tokenHash and leave token null.
  token             String?   @unique @db.VarChar(500)
  tokenHash         String?   @unique @map("token_hash") @db.VarChar(64)
  csrfTokenHash     String?   @map("csrf_token_hash") @db.VarChar(64)
  familyId          String    @default(uuid()) @map("family_id")
  userId            String    @map("user_id")
  expiresAt         DateTime  @map("expires_at")
  isRevoked         Boolean   @default(false) @map("is_revoked")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id")
  lastUsedAt        DateTime? @map("last_used_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId, isRevoked])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuthRateLimit {
  keyHash   String   @id @map("key_hash") @db.VarChar(64)
  count     Int      @default(0)
  resetAt   DateTime @map("reset_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([resetAt])
  @@map("auth_rate_limits")
}

model UserBranchAssignment {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  branchId  String   @map("branch_id")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId, userId])
  @@map("user_branch_assignments")
}

// ============================================================
// PRODUCTS, CATEGORIES & RECIPES
// ============================================================

model Category {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id         String      @id @default(uuid())
  sku        String      @unique @db.VarChar(50)
  name       String      @db.VarChar(150)
  type       ProductType
  basePrice  Decimal     @default(0) @map("base_price") @db.Decimal(12, 2)
  image      String?     @db.VarChar(500)
  categoryId String?     @map("category_id")
  isActive   Boolean     @default(true) @map("is_active")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  category      Category?     @relation(fields: [categoryId], references: [id])
  sizes         ProductSize[]
  // Recipe: this product (drink) uses materials
  recipeItems   RecipeItem[]  @relation("DrinkRecipe")
  // Recipe: this product (material) is used in drinks
  usedInRecipes RecipeItem[]  @relation("MaterialUsage")
  orderItems    OrderItem[]
  inventories   Inventory[]

  @@index([type])
  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

model ProductSize {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  name      String  @db.VarChar(10) // S, M, L
  priceAdj  Decimal @default(0) @map("price_adjustment") @db.Decimal(12, 2)

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  recipeItems RecipeItem[]
  orderItems  OrderItem[]

  @@unique([productId, name])
  @@map("product_sizes")
}

model RecipeItem {
  id         String  @id @default(uuid())
  drinkId    String  @map("drink_id")
  materialId String  @map("material_id")
  sizeId     String? @map("size_id")
  quantity   Decimal @db.Decimal(10, 3)
  unit       String  @db.VarChar(20) // ml, g, pcs

  drink    Product      @relation("DrinkRecipe", fields: [drinkId], references: [id], onDelete: Cascade)
  material Product      @relation("MaterialUsage", fields: [materialId], references: [id])
  size     ProductSize? @relation(fields: [sizeId], references: [id])

  @@unique([drinkId, materialId, sizeId])
  @@index([drinkId])
  @@index([materialId])
  @@map("recipe_items")
}

// ============================================================
// ORDERS & PAYMENTS (POS)
// ============================================================

model Order {
  id           String      @id @default(uuid())
  orderNumber  String      @map("order_number") @db.VarChar(20)
  branchId     String      @map("branch_id")
  cashierId    String      @map("cashier_id")
  customerId   String?     @map("customer_id")
  promotionId  String?     @map("promotion_id")
  subtotal     Decimal     @default(0) @db.Decimal(12, 2)
  discount     Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount  Decimal     @default(0) @map("total_amount") @db.Decimal(12, 2)
  pointsEarned Int         @default(0) @map("points_earned")
  status       OrderStatus @default(PENDING)
  note         String?     @db.Text
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  branch       Branch        @relation(fields: [branchId], references: [id])
  cashier      User          @relation(fields: [cashierId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  promotion    Promotion?    @relation(fields: [promotionId], references: [id])
  items        OrderItem[]
  payments     Payment[]
  stockLedgers StockLedger[]

  @@unique([branchId, orderNumber])
  @@index([branchId, createdAt])
  @@index([cashierId])
  @@index([status])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String  @map("order_id")
  productId  String  @map("product_id")
  sizeId     String? @map("size_id")
  qty        Int     @default(1)
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)
  subtotal   Decimal @db.Decimal(12, 2)
  // JSON attributes: { "ice": 50, "sugar": 70, "toppings": ["tran-chau", "thach"] }
  attributes Json?   @db.JsonB

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])
  size    ProductSize? @relation(fields: [sizeId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @map("order_id")
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  transactionId String?       @map("transaction_id") @db.VarChar(100) // External ref (VNPay/MoMo)
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([transactionId])
  @@map("payments")
}

// ============================================================
// INVENTORY & STOCK LEDGER
// ============================================================

model Inventory {
  id           String   @id @default(uuid())
  branchId     String   @map("branch_id")
  materialId   String   @map("material_id")
  currentStock Decimal  @default(0) @map("current_stock") @db.Decimal(12, 3)
  minStock     Decimal  @default(0) @map("min_stock") @db.Decimal(12, 3)
  unit         String   @db.VarChar(20)
  updatedAt    DateTime @updatedAt @map("updated_at")

  branch       Branch        @relation(fields: [branchId], references: [id])
  material     Product       @relation(fields: [materialId], references: [id])
  stockLedgers StockLedger[]

  @@unique([branchId, materialId])
  @@index([branchId])
  @@map("inventories")
}

model StockLedger {
  id           String       @id @default(uuid())
  branchId     String       @map("branch_id")
  materialId   String       @map("material_id")
  inventoryId  String       @map("inventory_id")
  changeQty    Decimal      @map("change_qty") @db.Decimal(12, 3)
  balanceAfter Decimal      @map("balance_after") @db.Decimal(12, 3)
  refType      StockRefType @map("ref_type")
  refId        String?      @map("ref_id")
  note         String?      @db.Text
  createdBy    String?      @map("created_by")
  createdAt    DateTime     @default(now()) @map("created_at")

  branch    Branch    @relation(fields: [branchId], references: [id])
  inventory Inventory @relation(fields: [inventoryId], references: [id])
  order     Order?    @relation(fields: [refId], references: [id])

  @@index([branchId, materialId, createdAt])
  @@index([refType, refId])
  @@map("stock_ledgers")
}

// ============================================================
// CUSTOMERS & LOYALTY POINTS
// ============================================================

model Customer {
  id          String   @id @default(uuid())
  fullName    String   @map("full_name") @db.VarChar(100)
  phone       String   @unique @db.VarChar(20)
  email       String?  @db.VarChar(150)
  totalPoints Int      @default(0) @map("total_points")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  orders            Order[]
  pointTransactions PointTransaction[]

  @@index([phone])
  @@map("customers")
}

model PointTransaction {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  points     Int // + for earn, - for redeem
  reason     String   @db.VarChar(255) // "Order #001", "Redeem voucher"
  refId      String?  @map("ref_id") // order_id
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("point_transactions")
}

// ============================================================
// PROMOTIONS
// ============================================================

model Promotion {
  id            String        @id @default(uuid())
  name          String        @db.VarChar(150)
  description   String?       @db.Text
  type          PromotionType
  value         Decimal       @db.Decimal(12, 2) // % or fixed amount
  minOrderValue Decimal?      @map("min_order_value") @db.Decimal(12, 2)
  maxDiscount   Decimal?      @map("max_discount") @db.Decimal(12, 2)
  startDate     DateTime      @map("start_date")
  endDate       DateTime      @map("end_date")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  orders Order[]

  @@index([isActive, startDate, endDate])
  @@map("promotions")
}

// ============================================================
// HR: ATTENDANCE, SCHEDULES, SALARY, ANNOUNCEMENTS
// ============================================================

model Attendance {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  date        DateTime  @db.Date
  checkIn     DateTime? @map("check_in")
  checkOut    DateTime? @map("check_out")
  hoursWorked Decimal?  @map("hours_worked") @db.Decimal(5, 2)
  note        String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("attendances")
}

model WorkSchedule {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  branchId  String   @map("branch_id")
  date      DateTime @db.Date
  shiftName String   @map("shift_name") @db.VarChar(50) // "Ca sáng", "Ca tối"
  startTime String   @map("start_time") @db.VarChar(5) // "08:00"
  endTime   String   @map("end_time") @db.VarChar(5) // "16:00"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([userId, date, shiftName])
  @@index([userId, date])
  @@index([branchId, date])
  @@map("work_schedules")
}

model SalarySlip {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  month      Int // 1-12
  year       Int
  baseSalary Decimal   @map("base_salary") @db.Decimal(12, 2)
  bonus      Decimal   @default(0) @db.Decimal(12, 2)
  deduction  Decimal   @default(0) @db.Decimal(12, 2)
  netSalary  Decimal   @map("net_salary") @db.Decimal(12, 2)
  note       String?   @db.Text
  isPaid     Boolean   @default(false) @map("is_paid")
  paidAt     DateTime? @map("paid_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([userId])
  @@map("salary_slips")
}

model Announcement {
  id        String   @id @default(uuid())
  title     String   @db.VarChar(200)
  content   String   @db.Text
  authorId  String   @map("author_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, createdAt])
  @@map("announcements")
}

// ============================================================
// FINANCE: SIMPLE CASH FLOW
// ============================================================

model CashFlow {
  id          String       @id @default(uuid())
  branchId    String       @map("branch_id")
  type        CashFlowType
  amount      Decimal      @db.Decimal(12, 2)
  description String       @db.VarChar(255)
  refType     String?      @map("ref_type") @db.VarChar(30) // ORDER, SALARY, IMPORT, OTHER
  refId       String?      @map("ref_id")
  createdBy   String       @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId, createdAt])
  @@index([type])
  @@map("cash_flows")
}

// ============================================================
// PLATFORM: AUDIT, IDEMPOTENCY & TRANSACTIONAL OUTBOX
// ============================================================

model DocumentSequence {
  id           String   @id @default(uuid())
  documentType String   @map("document_type") @db.VarChar(32)
  branchId     String   @map("branch_id")
  businessDate DateTime @map("business_date") @db.Date
  lastValue    Int      @default(0) @map("last_value")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([documentType, branchId, businessDate])
  @@map("document_sequences")
}

model ApprovalRequest {
  id              String         @id @default(uuid())
  resourceType    String         @map("resource_type") @db.VarChar(80)
  resourceId      String         @map("resource_id") @db.VarChar(100)
  action          String         @db.VarChar(100)
  resourceVersion Int            @map("resource_version")
  branchId        String         @map("branch_id")
  requestedById   String         @map("requested_by_id")
  status          ApprovalStatus @default(PENDING)
  reason          String?        @db.VarChar(500)
  metadata        Json?          @db.JsonB
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch      Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  requestedBy User              @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decision    ApprovalDecision?

  @@unique([resourceType, resourceId, action, resourceVersion])
  @@index([branchId, status, createdAt])
  @@index([requestedById, createdAt])
  @@map("approval_requests")
}

model ApprovalDecision {
  id                String               @id @default(uuid())
  approvalRequestId String               @unique @map("approval_request_id")
  decision          ApprovalDecisionType
  decidedById       String               @map("decided_by_id")
  reason            String?              @db.VarChar(500)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  decidedBy       User            @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([decidedById, createdAt])
  @@map("approval_decisions")
}

model AuditEvent {
  id            String   @id @default(uuid())
  actorId       String?  @map("actor_id")
  branchId      String?  @map("branch_id")
  action        String   @db.VarChar(100)
  resourceType  String   @map("resource_type") @db.VarChar(80)
  resourceId    String?  @map("resource_id") @db.VarChar(100)
  reason        String?  @db.VarChar(500)
  metadata      Json?    @db.JsonB
  correlationId String   @map("correlation_id") @db.VarChar(128)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([branchId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([correlationId])
  @@index([createdAt, id])
  @@map("audit_events")
}

model IdempotencyRecord {
  id             String            @id @default(uuid())
  actorId        String            @map("actor_id")
  scopeKey       String            @map("scope_key") @db.VarChar(64)
  action         String            @db.VarChar(100)
  key            String            @db.VarChar(128)
  requestHash    String            @map("request_hash") @db.VarChar(64)
  status         IdempotencyStatus @default(PROCESSING)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body") @db.JsonB
  resourceType   String?           @map("resource_type") @db.VarChar(80)
  resourceId     String?           @map("resource_id") @db.VarChar(100)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, scopeKey, action, key])
  @@index([expiresAt])
  @@index([status, updatedAt])
  @@index([status, expiresAt, id])
  @@map("idempotency_records")
}

model OutboxEvent {
  id            String       @id @default(uuid())
  aggregateType String       @map("aggregate_type") @db.VarChar(80)
  aggregateId   String       @map("aggregate_id") @db.VarChar(100)
  eventType     String       @map("event_type") @db.VarChar(120)
  payload       Json         @db.JsonB
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedAt      DateTime?    @map("locked_at") @db.Timestamptz(3)
  lockedBy      String?      @map("locked_by") @db.VarChar(100)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(3)
  lastError     String?      @map("last_error") @db.VarChar(1000)
  correlationId String       @map("correlation_id") @db.VarChar(128)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, availableAt, createdAt])
  @@index([status, publishedAt, id])
  @@index([status, createdAt, id])
  @@index([aggregateType, aggregateId])
  @@index([correlationId])
  @@map("outbox_events")
}
